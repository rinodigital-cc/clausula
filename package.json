{
  "name": "apoiaseguro",
  "version": "0.1.0",
  "private": true,
  "description": "ApoIA Seguro — plataforma de IA para corretoras de seguros (MVP)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "worker": "tsx services/worker/index.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:roles": "tsx db/setup-login-roles.ts",
    "plataforma:admin": "tsx scripts/criar-admin-plataforma.ts",
    "fixtures:pdfs": "tsx tests/fixtures/gerar-pdfs.ts",
    "typecheck": "tsc --noEmit",
    "test:isolation": "tsx tests/run-sql.ts tests/sql/isolation.sql",
    "test:unit": "tsx tests/unit/nucleo.legacy.test.ts && node --import tsx --test tests/unit/safety.test.ts tests/unit/email.test.ts",
    "test:integration": "NODE_ENV=test node --conditions=react-server --import tsx tests/integration/p0.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:isolation && npm run test:integration",
    "lint": "eslint . --max-warnings=0",
    "cloud:setup": "node scripts/codex-cloud.mjs setup",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
