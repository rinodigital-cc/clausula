# ApoIA Seguro — variáveis de ambiente (copie para .env.local e preencha).
# Nenhum valor real neste arquivo. Endereços abaixo são PROPOSTOS, não configurados.

# ---------------------------------------------------------------- banco
# Papel dono do schema: roda migrações e cria os usuários de login (nunca usado pela aplicação).
DATABASE_URL_ADMIN=postgres://postgres:SENHA@localhost:5432/apoiaseguro

# Senhas dos usuários de login criados por `npm run db:roles` (um por papel)
DB_PASSWORD_APP=
DB_PASSWORD_BOOTSTRAP=
DB_PASSWORD_PLATFORM=
DB_PASSWORD_WORKER=
DB_PASSWORD_PUBLIC=

# Conexões de runtime, cada uma com o usuário do seu papel (RLS sempre ativo)
DATABASE_URL=postgres://apoia_app:SENHA@localhost:5432/apoiaseguro
BOOTSTRAP_DATABASE_URL=postgres://apoia_bootstrap:SENHA@localhost:5432/apoiaseguro
PLATFORM_DATABASE_URL=postgres://apoia_platform:SENHA@localhost:5432/apoiaseguro
WORKER_DATABASE_URL=postgres://apoia_worker:SENHA@localhost:5432/apoiaseguro
PUBLIC_DATABASE_URL=postgres://apoia_public:SENHA@localhost:5432/apoiaseguro

# ---------------------------------------------------------------- aplicação
APP_URL=http://localhost:3000            # produção: https://app.apoiaseguro.com.br (proposto)
PUBLIC_SITE_URL=https://apoiaseguro.com.br
SESSION_SECRET=                          # 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
STORAGE_DIR=./storage                    # PDFs enviados; em produção precisa ser disco persistente

# Limites de uso (opcionais)
RATE_LIMIT_USER_HOUR=60                  # perguntas por pessoa por hora
# RATE_LIMIT_ORG_HOUR=600               # perguntas por corretora por hora (comentado = padrão do código; não deixe vazio)
DAILY_BUDGET_BRL=0                       # teto diário de gasto com IA por corretora; 0 = sem teto

# ---------------------------------------------------------------- IA
# Sem chave, as respostas usam só frases literais dos documentos (modo literal).
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
ANSWER_MODEL_ECONOMY=claude-haiku-5-5
AI_PRICE_IN_BRL_PER_MTOK=0               # preço por milhão de tokens, para o controle de orçamento
AI_PRICE_OUT_BRL_PER_MTOK=0

# ---------------------------------------------------------------- e-mail
# Sem chave, os e-mails ficam gravados (tabela email_outbox / arquivo) e NÃO são enviados.
EMAIL_TRANSPORT=file
RESEND_API_KEY=
EMAIL_FROM="ApoIA Seguro <nao-responda@apoiaseguro.com.br>"   # proposto; exige domínio verificado
